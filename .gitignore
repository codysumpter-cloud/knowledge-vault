.DS_Store
__MACOSX/
.trash/

# Archives / package artifacts
*.zip

# Python local/runtime state
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
dist/
build/
*.egg-info/

# ChatGPT raw exports / private intake material
conversations.json
chat.html
message_feedback.json
model_comparisons.json
user.json
chatgpt-export*/
chatgpt-history-raw*/
raw-chatgpt*/
local-chatgpt*/

# Obsidian local workspace state
.obsidian/workspace.json
.obsidian/workspaces.json
.obsidian/plugins/obsidian-git/obsidian_askpass.sh

# Plugin local/runtime state
.obsidian/plugins/*/data.json
.obsidian/plugins/*/cache/
.obsidian/plugins/*/.cache/
.makemd/
.space/

# Private vault material: never publish private notes, certificates, logs, or local state
00-Private/**
!00-Private/
!00-Private/README.md

# Security / local-only system material
99-System/Security/**
99-System/Logs/**
99-System/Backups/**
99-System/Prompts/**
99-System/Templates/**

# Memory Engine generated outputs
99-System/Memory Engine/memory-index.json
99-System/Memory Engine/memory-graph.json
99-System/Memory Engine/Obsidian Memory Index.md
99-System/Context Bundles/*.bundle.md
99-System/Context Bundles/*.receipt.json

# Credentials / signing / private key material
*.certSigningRequest
*.cer
*.p12
*.pem
*.key
*.mobileprovision
**/secret*
**/token*
**/.env
*/.env.*

# Sensitive generated logs
Archive_Hermes_Logs_*.md

# Accidental nested vaults / local mirrors
Obsidian Vault/

# Generated vault indexes and automation outputs (do not commit)
KNOWLEDGE_VAULT_INDEX.json
KNOWLEDGE_VAULT_INDEX.md
test/
*.tmp
