<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.prismtek.knowledgevault.steward</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_WITH_VAULT_PATH/99-System/Automation/run-vault-steward-mac-safe.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>17</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/knowledge-vault-steward.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/knowledge-vault-steward.err.log</string>
  <key>Nice</key>
  <integer>19</integer>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
