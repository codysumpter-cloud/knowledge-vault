{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codysumpter-cloud/knowledge-vault/99-System/Schemas/note.schema.json",
  "title": "KnowledgeVault Note Metadata",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "type",
    "status",
    "owner",
    "source_of_truth",
    "last_verified",
    "risk_level",
    "privacy"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "project",
        "decision",
        "runbook",
        "skill",
        "source",
        "dashboard",
        "handoff",
        "index",
        "bundle",
        "automation-readme",
        "standard",
        "schema"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "reference",
        "draft",
        "active",
        "wired",
        "tested",
        "stale",
        "disabled",
        "public-alpha-safe"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "source_of_truth": {
      "type": "string",
      "enum": [
        "github",
        "knowledge-vault",
        "runtime-repo",
        "external-source",
        "mixed"
      ]
    },
    "last_verified": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "privacy": {
      "type": "string",
      "enum": ["public", "local-only", "private-companion"]
    },
    "freshness": {
      "type": "string",
      "enum": ["stable", "slow-changing", "volatile", "high-stakes"]
    },
    "agent_load": {
      "type": "string",
      "enum": ["cold-start", "task-specific", "reference-only", "never-auto-load"]
    },
    "runtime_target": {
      "type": "string"
    },
    "requires_network": {
      "type": "boolean"
    },
    "requires_private_config": {
      "type": "boolean"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
