{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prismtek.dev/schemas/wikipedia-karpathy-topic.schema.json",
  "title": "Wikipedia Karpathy Topic Card",
  "description": "Schema for compact, source-grounded concept cards derived from English Wikipedia without storing large verbatim article mirrors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "slug",
    "note_type",
    "source",
    "freshness",
    "tiny_model",
    "primitives",
    "relationships",
    "read_next",
    "quality"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "note_type": {
      "type": "string",
      "enum": [
        "concept_card",
        "learning_note",
        "source_map",
        "reading_path",
        "citation_index"
      ]
    },
    "domain": {
      "type": "string",
      "examples": [
        "mathematics",
        "physics",
        "history",
        "computing",
        "biology",
        "culture"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "title",
        "url",
        "retrieved_at"
      ],
      "properties": {
        "project": {
          "type": "string",
          "const": "English Wikipedia"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "revision_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date"
        },
        "license_note": {
          "type": "string"
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "verify_live_before_answering"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "stable",
            "medium",
            "volatile"
          ]
        },
        "verify_live_before_answering": {
          "type": "boolean"
        },
        "why": {
          "type": "string"
        },
        "external_authorities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tiny_model": {
      "type": "string",
      "minLength": 1,
      "description": "One-sentence original intuition for the topic."
    },
    "why_it_exists": {
      "type": "string"
    },
    "primitives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "meaning"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          }
        }
      }
    },
    "mechanism": {
      "type": "string"
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "relation",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "relation": {
            "type": "string",
            "enum": [
              "depends_on",
              "contains",
              "contrasts_with",
              "causes",
              "enables",
              "emerged_from",
              "measures",
              "explains",
              "part_of",
              "example_of"
            ]
          },
          "to": {
            "type": "string"
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counterexamples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "common_confusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "read_next": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "reason"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "has_source_url",
        "has_retrieval_date",
        "has_freshness_label",
        "has_original_summary",
        "has_no_large_verbatim_copy"
      ],
      "properties": {
        "has_source_url": {
          "type": "boolean",
          "const": true
        },
        "has_retrieval_date": {
          "type": "boolean",
          "const": true
        },
        "has_freshness_label": {
          "type": "boolean",
          "const": true
        },
        "has_original_summary": {
          "type": "boolean",
          "const": true
        },
        "has_no_large_verbatim_copy": {
          "type": "boolean",
          "const": true
        },
        "reviewed_by": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
