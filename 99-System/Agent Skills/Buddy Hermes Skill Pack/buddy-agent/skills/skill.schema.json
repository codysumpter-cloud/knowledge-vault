{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prismtek.local/buddy/skill.schema.json",
  "title": "Buddy Skill Metadata",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "source",
    "platforms",
    "risk_class",
    "readable",
    "auto_executable",
    "requires_prismtek_approval",
    "adapters"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "canonical_memory_source": {
      "type": "string"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_class": {
      "enum": [
        "read-only",
        "draft-only",
        "write",
        "external-action",
        "destructive",
        "money"
      ]
    },
    "default_mode": {
      "type": "string"
    },
    "readable": {
      "type": "boolean"
    },
    "auto_executable": {
      "type": "boolean"
    },
    "requires_prismtek_approval": {
      "type": "boolean"
    },
    "manual_only_by_default": {
      "type": "boolean"
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_without_approval": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hard_blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
